diff --git a/libexec/rc/rc.d/os-release b/libexec/rc/rc.d/os-release
index 5f05e152e..3869d8b11 100755
--- a/libexec/rc/rc.d/os-release
+++ b/libexec/rc/rc.d/os-release
@@ -21,17 +21,24 @@ osrelease_start()
 	local _version _version_id
 
 	startmsg -n "Updating ${osrelease_file} "
-	_version=$(freebsd-version -u)
+	# A versão do LumeBSD (a do FreeBSD por baixo vai em BUILD_ID).
+	_base=$(freebsd-version -u)
+	_version=$(cat /usr/share/lume/versao 2>/dev/null || echo "${_base%%-*}")
 	_version_id=${_version%%[^0-9.]*}
 	t=$(mktemp -t os-release)
 	cat > "$t" <<-__EOF__
 		NAME=LumeBSD
-		VERSION="$_version"
+		VERSION="$_version (Farol)"
 		VERSION_ID="$_version_id"
 		VERSION_CODENAME=farol
+		BUILD_ID="FreeBSD $_base"
 		ID=lumebsd
 		ID_LIKE=freebsd
 		ANSI_COLOR="0;33"
+		LOGO=lumebsd
+		HOME_URL="https://github.com/Kalel047/lumebsd"
+		DOCUMENTATION_URL="https://github.com/Kalel047/lumebsd#readme"
+		BUG_REPORT_URL="https://github.com/Kalel047/lumebsd/issues"
 		PRETTY_NAME="LumeBSD $_version (Farol)"
 __EOF__
 	install -C -o root -g wheel -m ${osrelease_perms} "$t" "${osrelease_file}"
diff --git a/stand/images/Makefile b/stand/images/Makefile
index 2f45b989e..a39958d33 100644
--- a/stand/images/Makefile
+++ b/stand/images/Makefile
@@ -1,7 +1,7 @@
