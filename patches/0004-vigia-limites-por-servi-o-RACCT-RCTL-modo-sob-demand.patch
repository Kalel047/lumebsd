@@ -1,8 +1,12 @@
-# Servidor web mínimo na porta 8080, feito só com o nc(1) da base.
+# Página web "sob demanda": o vigia escuta a porta 8080 e só cria um
+# processo quando chega uma conexão. Sem visitas, nada roda.
 # Teste com: fetch -qo - http://127.0.0.1:8080/
 # A dependência do relógio existe só para mostrar a ordem de subida.
-descricao = Página "Olá" na porta 8080
-comando = sh -c 'while true; do printf "HTTP/1.0 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nOlá do LumeBSD! Servido pelo vigia.\n" | nc -N -l 8080; done'
+descricao = Página "Olá" na porta 8080 (sob demanda)
+escutar = tcp:8080
+max_conexoes = 10
+comando = sh -c 'cr=$(printf "\r"); while read -r l && [ "$l" != "$cr" ]; do :; done; printf "HTTP/1.0 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nOlá, %s! Atendido pelo vigia no LumeBSD.\n" "${VIGIA_CLIENTE%%:*}"'
 usuario = nobody
 depende = relogio
-reiniciar = sempre
+limite_memoria = 64M
+limite_processos = 20
