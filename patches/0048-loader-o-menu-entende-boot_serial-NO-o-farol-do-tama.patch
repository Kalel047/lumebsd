--- a/stand/lua/core.lua
+++ b/stand/lua/core.lua
@@ -533,15 +533,22 @@ function core.popFrontTable(tbl)
 	return first_value, new_tbl
 end
 
+-- boot_serial="NO" (or boot_multicons="NO") means off, as the kernel reads it
+-- (boot_env_to_howto); only a missing variable was treated as off here.
+local function envOn(name)
+	local v = loader.getenv(name)
+	return v ~= nil and v:lower() ~= "no"
+end
+
 function core.getConsoleName()
-	if loader.getenv("boot_multicons") ~= nil then
-		if loader.getenv("boot_serial") ~= nil then
+	if envOn("boot_multicons") then
+		if envOn("boot_serial") then
 			return "Dual (Serial primary)"
 		else
 			return "Dual (Video primary)"
 		end
 	else
-		if loader.getenv("boot_serial") ~= nil then
+		if envOn("boot_serial") then
 			return "Serial"
 		else
 			return "Video"
@@ -550,15 +557,15 @@ function core.getConsoleName()
 end
 
 function core.nextConsoleChoice()
-	if loader.getenv("boot_multicons") ~= nil then
-		if loader.getenv("boot_serial") ~= nil then
+	if envOn("boot_multicons") then
+		if envOn("boot_serial") then
 			loader.unsetenv("boot_serial")
 		else
 			loader.unsetenv("boot_multicons")
 			loader.setenv("boot_serial", "YES")
 		end
 	else
-		if loader.getenv("boot_serial") ~= nil then
+		if envOn("boot_serial") then
 			loader.unsetenv("boot_serial")
 		else
 			loader.setenv("boot_multicons", "YES")
