From c5de0a0b8fb625b5038d3b4c48bdf9debaf8b6e9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 12 Nov 2026 02:06:33 -0300
Subject: [PATCH] lume tema: a decoracao Papel e o splash do farol tambem pelo
 tema global

Os padroes do tema global (contents/defaults) ainda diziam a decoracao
Breeze e nenhum splash, e o Plasma os copia para ~/.config/kdedefaults,
que vale mais que o /usr/local/etc/xdg. Agora dizem a decoracao Papel e
o splash do farol (o da noite, no Papel noite); o lume tema integrar
corrige o kdedefaults de quem ja usa o Papel.
---
 usr.sbin/lume-configurar/lume-tema.sh        | 19 +++++++++++++++++++
 usr.sbin/lume-configurar/tema/defaults       |  6 +++---
 usr.sbin/lume-configurar/tema/defaults-noite |  6 +++---
 3 files changed, 25 insertions(+), 6 deletions(-)

diff --git a/usr.sbin/lume-configurar/lume-tema.sh b/usr.sbin/lume-configurar/lume-tema.sh
index d49589a4c..5816bba11 100644
--- a/usr.sbin/lume-configurar/lume-tema.sh
+++ b/usr.sbin/lume-configurar/lume-tema.sh
@@ -209,6 +209,7 @@ integrar()
 		instalar $T/PapelNoite.colorscheme $P/share/konsole/PapelNoite.colorscheme
 		instalar $T/PapelNoite.profile $P/share/konsole/PapelNoite.profile
 		instalar $T/metadata-noite.json $LNF_NOITE/metadata.json
+		instalar $T/defaults $LNF/contents/defaults
 		instalar $T/defaults-noite $LNF_NOITE/contents/defaults
 		instalar $T/layout-noite.js $LNF_NOITE/contents/layouts/org.kde.plasma.desktop-layout.js
 		instalar $T/papel-noite.png $LNF_NOITE/contents/previews/preview.png
@@ -221,6 +222,24 @@ integrar()
 		instalar $T/layout.js $LNF/contents/layouts/org.kde.plasma.desktop-layout.js
 		instalar $T/layout-noite.js $LNF_NOITE/contents/layouts/org.kde.plasma.desktop-layout.js
 		marca >/dev/null
+		# Quem usa o Papel ou o Papel noite: os padrões do tema global que o
+		# Plasma copiou para ~/.config/kdedefaults (os de antes da 2.0 diziam a
+		# decoração Breeze e nenhum splash) passam à decoração Papel e ao splash
+		# do farol. (sobrescreve o conteúdo, sem recriar o arquivo: ele
+		# continua do usuário)
+		for d in /home/*/.config/kdedefaults; do
+			grep -qs '^ColorScheme=Papel' "$d/kdeglobals" || continue
+			noite=; grep -qs '^ColorScheme=PapelNoite' "$d/kdeglobals" && noite=-noite
+			for rc in "$d/kwinrc" "$d/ksplashrc"; do
+				[ -f "$rc" ] || continue
+				tmp=$(mktemp)
+				sed -e 's/^library=org\.kde\.breeze$/library=org.lumebsd.papel/' \
+				    -e 's/^theme=Breeze$/theme=Papel/' \
+				    -e "s/^Theme=None\$/Theme=org.lumebsd.papel$noite/" "$rc" > "$tmp" &&
+				    cat "$tmp" > "$rc"
+				rm -f "$tmp"
+			done
+		done
 		# (sobrescreve o conteúdo, sem recriar o arquivo: ele continua do usuário)
 		for rc in /home/*/.config/plasma-org.kde.plasma.desktop-appletsrc; do
 			[ -f "$rc" ] && grep -q '^icon=start-here-kde\(-plasma\)\{0,1\}-symbolic$' "$rc" || continue
diff --git a/usr.sbin/lume-configurar/tema/defaults b/usr.sbin/lume-configurar/tema/defaults
index eff99babf..0ca40b9f1 100644
--- a/usr.sbin/lume-configurar/tema/defaults
+++ b/usr.sbin/lume-configurar/tema/defaults
@@ -11,11 +11,11 @@ Theme=lume-papel
 name=default
 
 [kwinrc][org.kde.kdecoration2]
-library=org.kde.breeze
-theme=Breeze
+library=org.lumebsd.papel
+theme=Papel
 
 [KSplash]
-Theme=None
+Theme=org.lumebsd.papel
 
 [Wallpaper]
 Image=LumePapel
diff --git a/usr.sbin/lume-configurar/tema/defaults-noite b/usr.sbin/lume-configurar/tema/defaults-noite
index 524531da6..7d6cc42d0 100644
--- a/usr.sbin/lume-configurar/tema/defaults-noite
+++ b/usr.sbin/lume-configurar/tema/defaults-noite
@@ -11,11 +11,11 @@ Theme=lume-papel-noite
 name=default
 
 [kwinrc][org.kde.kdecoration2]
-library=org.kde.breeze
-theme=Breeze
+library=org.lumebsd.papel
+theme=Papel
 
 [KSplash]
-Theme=None
+Theme=org.lumebsd.papel-noite
 
 [Wallpaper]
 Image=LumePapelNoite
