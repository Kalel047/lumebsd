From c1d21298f4abd9d0e614e8127c548bd9eba2e240 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 22:30:20 -0300
Subject: [PATCH] lume-configurar: o assistente do primeiro boot vai para a
 tela
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

O rc roda o assistente no console principal. Se ele for a serial (um
firmware que a põe na frente), as perguntas iam para lá e a pessoa via só
um cursor. No boot, o assistente agora usa o ttyv0, a não ser que o
console serial tenha sido pedido (boot_serial="YES", os testes).
---
 usr.sbin/lume-configurar/lume-configurar.sh | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/usr.sbin/lume-configurar/lume-configurar.sh b/usr.sbin/lume-configurar/lume-configurar.sh
index 080b89507..d01965cf6 100644
--- a/usr.sbin/lume-configurar/lume-configurar.sh
+++ b/usr.sbin/lume-configurar/lume-configurar.sh
@@ -14,6 +14,18 @@ MARCA=/var/db/lume/configurado
 MODO=manual
 [ "$1" = "--boot" ] && MODO=boot
 
+# No boot, o rc roda o assistente no console principal. Numa máquina virtual
+# com porta serial (o virt-manager cria uma), o firmware pode fazer da serial
+# o console principal, e as perguntas iriam para lá: a pessoa veria só um
+# cursor. O assistente é para quem está na frente da tela, então vai para
+# ela (ttyv0), a não ser que o console serial tenha sido pedido de propósito
+# (boot_serial="YES" no loader.conf, como nos testes automáticos).
+if [ "$MODO" = boot ] && [ -c /dev/ttyv0 ] &&
+    ! grep -qs '^boot_serial="YES"' /boot/loader.conf &&
+    [ "$(tty </dev/stdin 2>/dev/null)" != /dev/ttyv0 ]; then
+	exec </dev/ttyv0 >/dev/ttyv0 2>&1
+fi
+
 if [ "$(id -u)" -ne 0 ]; then
 	echo "lume-configurar: precisa ser executado como root (use: su -)." >&2
 	exit 1
