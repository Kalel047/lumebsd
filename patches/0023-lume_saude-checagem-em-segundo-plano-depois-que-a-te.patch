From 6617bdbbd8e2e47367c564d2d6d674a7ba67703d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 00:59:05 -0300
Subject: [PATCH] lume_saude: checagem em segundo plano, depois que a tela de
 login sobe
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

No rcorder o lume_saude roda antes do SDDM; esperando por ele, dava um
falso "a tela de login não subiu". Agora a checagem roda em segundo
plano (até 2 min pelo SDDM) e o boot não espera.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CMniwHHqnsVXVYi22gBRrS
---
 libexec/rc/rc.d/lume_saude | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/libexec/rc/rc.d/lume_saude b/libexec/rc/rc.d/lume_saude
index 4d35db793..c7f0c8086 100644
--- a/libexec/rc/rc.d/lume_saude
+++ b/libexec/rc/rc.d/lume_saude
@@ -52,15 +52,14 @@ checar()
 		i=0
 		until pgrep -q -x sddm; do
 			i=$((i + 1))
-			[ $i -ge 30 ] && { echo "a tela de login (sddm) não subiu"; return; }
+			[ $i -ge 60 ] && { echo "a tela de login (sddm) não subiu"; return; }
 			sleep 2
 		done
 	fi
 }
 
-lume_saude_start()
+confirmar_ou_avisar()
 {
-	[ -f "$PENDENTE" ] || return 0
 	versao=$(campo "$PENDENTE" versao)
 	be=$(campo "$PENDENTE" ambiente)
 	anterior=$(campo "$PENDENTE" anterior)
@@ -78,6 +77,15 @@ lume_saude_start()
 	logger -t lume "atualização $versao não confirmada ($be): $problema"
 }
 
+lume_saude_start()
+{
+	[ -f "$PENDENTE" ] || return 0
+	# Em segundo plano: serviços que sobem depois deste (a tela de login)
+	# também entram na checagem, e o boot não espera por ela.
+	echo "LumeBSD: atualização em teste; conferindo o sistema em segundo plano."
+	confirmar_ou_avisar > /dev/console 2>&1 &
+}
+
 load_rc_config $name
 : ${lume_saude_enable:="YES"}
 run_rc_command "$1"
