+# Gerado por ferramentas/montar tema-noite a partir do Papel; não edite à mão.
 # Esquema de cores "Papel noite" do LumeBSD: o Papel à noite.
 # Papel, tinta e cinzas; o único tom é o vermelho de revisor, para erros.
 [General]
diff --git a/usr.sbin/lume-configurar/tema/PapelNoite.colorscheme b/usr.sbin/lume-configurar/tema/PapelNoite.colorscheme
index bd24de804..e498d84d6 100644
--- a/usr.sbin/lume-configurar/tema/PapelNoite.colorscheme
+++ b/usr.sbin/lume-configurar/tema/PapelNoite.colorscheme
@@ -1,5 +1,5 @@
 # Esquema de cores do Konsole "Papel noite" (LumeBSD): o Papel à noite.
-# Gerado por ferramentas/tema-noite.py a partir do Papel.
+# Gerado por ferramentas/montar tema-noite a partir do Papel.
 [Background]
 Color=30,29,27
 
