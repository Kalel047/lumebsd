From 276dbdd109d3eaca28c45bb32d53cc164a3e1e38 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 22:02:50 -0300
Subject: [PATCH] LumeBSD 1.3
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Série 1.3 no kernel, no uname, na mensagem de boas-vindas, nos
assistentes e no papel de parede.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CMniwHHqnsVXVYi22gBRrS
---
 sys/amd64/conf/LUME                           |   2 +-
 sys/conf/newvers.sh                           |   2 +-
 sys/sys/copyright.h                           |   2 +-
 usr.bin/login/motd.template                   |   2 +-
 usr.sbin/forja/forja.8                        |   2 +-
 usr.sbin/forja/forja.sh                       |   2 +-
 usr.sbin/lume-configurar/lume-configurar.sh   |   2 +-
 usr.sbin/lume-configurar/tema/metadata.json   |   2 +-
 usr.sbin/lume-configurar/tema/papel-noite.png | Bin 49307 -> 49352 bytes
 usr.sbin/lume-configurar/tema/papel.png       | Bin 48191 -> 48245 bytes
 10 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/sys/amd64/conf/LUME b/sys/amd64/conf/LUME
index 79106d5d2..eb456ac80 100644
--- a/sys/amd64/conf/LUME
+++ b/sys/amd64/conf/LUME
@@ -1,5 +1,5 @@
 #
-# LUME -- kernel do LumeBSD 1.2 "Farol" para amd64.
+# LUME -- kernel do LumeBSD 1.3 "Farol" para amd64.
 # Parte do GENERIC: todos os drivers e módulos, DTrace e ZFS.
 # Os símbolos de depuração são gerados (o DTrace precisa deles para o CTF),
 # mas não são instalados (WITHOUT_DEBUG_FILES no src.conf).
diff --git a/sys/conf/newvers.sh b/sys/conf/newvers.sh
index 0e930da13..5b1646b38 100644
--- a/sys/conf/newvers.sh
+++ b/sys/conf/newvers.sh
@@ -50,7 +50,7 @@
 #
 
 TYPE="LumeBSD"
-REVISION="1.2"
+REVISION="1.3"
 BRANCH="FAROL"
 # Versão do FreeBSD por baixo: o compilador mira nela (x86_64-unknown-freebsd15.1).
 FREEBSD_REVISION="15.1"
diff --git a/sys/sys/copyright.h b/sys/sys/copyright.h
index 3cd00bf8f..05ecfc91e 100644
--- a/sys/sys/copyright.h
+++ b/sys/sys/copyright.h
@@ -30,7 +30,7 @@
 /* Add a FreeBSD vendor copyright here - or via CFLAGS */
 #ifndef COPYRIGHT_Vendor
 #define	COPYRIGHT_Vendor \
-	"LumeBSD 1.2 \"Farol\" - an independent BSD distribution built on FreeBSD.\n"
+	"LumeBSD 1.3 \"Farol\" - an independent BSD distribution built on FreeBSD.\n"
 #endif
 
 /* FreeBSD */
diff --git a/usr.bin/login/motd.template b/usr.bin/login/motd.template
index f321a023a..b70cd79be 100644
--- a/usr.bin/login/motd.template
+++ b/usr.bin/login/motd.template
@@ -1,5 +1,5 @@
 
-   LumeBSD 1.2 "Farol"  -  luz firme sobre fundação BSD
+   LumeBSD 1.3 "Farol"  -  luz firme sobre fundação BSD
 
    Este é o LumeBSD, uma distribuição BSD independente construída
    a partir do código-fonte do FreeBSD.
diff --git a/usr.sbin/forja/forja.8 b/usr.sbin/forja/forja.8
index 965d04b35..0ad5193c2 100644
--- a/usr.sbin/forja/forja.8
+++ b/usr.sbin/forja/forja.8
@@ -80,7 +80,7 @@ segue com a que já existe.
 A árvore de ports confere a versão do sistema; como o
 .Xr uname 1
 do LumeBSD diz
-.Dq 1.2-FAROL ,
+.Dq 1.3-FAROL ,
 a forja passa a ela a versão do FreeBSD por baixo
 .Pq Va _OSRELEASE ,
 tirada de
diff --git a/usr.sbin/forja/forja.sh b/usr.sbin/forja/forja.sh
index 6707fd8d6..309b4575e 100644
--- a/usr.sbin/forja/forja.sh
+++ b/usr.sbin/forja/forja.sh
@@ -25,7 +25,7 @@ LOGS=/var/log/forja
 PORTS=${PORTSDIR:-/usr/ports}
 
 # Para a árvore de ports e os programas que ela compila, o sistema é o
-# FreeBSD por baixo do LumeBSD: o uname diz "LumeBSD 1.2-FAROL", que o
+# FreeBSD por baixo do LumeBSD: o uname diz "LumeBSD 1.3-FAROL", que o
 # configure dos programas não conhece. A versão vem do kern.osreldate
 # (1501000 -> 15.1-RELEASE); o uname(1) respeita UNAME_s e UNAME_r, e os
 # ports repassam essas variáveis para cada compilação.
diff --git a/usr.sbin/lume-configurar/lume-configurar.sh b/usr.sbin/lume-configurar/lume-configurar.sh
index 46286b90f..2d48d8259 100644
--- a/usr.sbin/lume-configurar/lume-configurar.sh
+++ b/usr.sbin/lume-configurar/lume-configurar.sh
@@ -25,7 +25,7 @@ cabecalho()
 {
 	echo
 	echo "  ============================================================"
-	echo "     LumeBSD 1.2 \"Farol\"  -  assistente de configuração"
+	echo "     LumeBSD 1.3 \"Farol\"  -  assistente de configuração"
 	echo "  ============================================================"
 	echo
 }
diff --git a/usr.sbin/lume-configurar/tema/metadata.json b/usr.sbin/lume-configurar/tema/metadata.json
index e125b1b2d..fcffa8e5b 100644
--- a/usr.sbin/lume-configurar/tema/metadata.json
+++ b/usr.sbin/lume-configurar/tema/metadata.json
@@ -5,7 +5,7 @@
         "Id": "org.lumebsd.papel",
         "License": "BSD-2-Clause",
         "Name": "Papel (LumeBSD)",
-        "Version": "1.2"
+        "Version": "1.3"
     },
     "KPackageStructure": "Plasma/LookAndFeel",
     "X-Plasma-APIVersion": "2"
diff --git a/usr.sbin/lume-configurar/tema/papel-noite.png b/usr.sbin/lume-configurar/tema/papel-noite.png
index 5f8c6cc7ba62ca1c6b1882a4c2ac0396e399ff9d..57ddeb64640b9cc791db3d671916d75ca53b706e 100644
