@@ -25,15 +25,14 @@ osrelease_start()
 	_version_id=${_version%%[^0-9.]*}
 	t=$(mktemp -t os-release)
 	cat > "$t" <<-__EOF__
-		NAME=FreeBSD
+		NAME=LumeBSD
 		VERSION="$_version"
 		VERSION_ID="$_version_id"
-		ID=freebsd
-		ANSI_COLOR="0;31"
-		PRETTY_NAME="FreeBSD $_version"
-		CPE_NAME="cpe:/o:freebsd:freebsd:$_version_id"
-		HOME_URL="https://FreeBSD.org/"
-		BUG_REPORT_URL="https://bugs.FreeBSD.org/"
+		VERSION_CODENAME=farol
+		ID=lumebsd
+		ID_LIKE=freebsd
+		ANSI_COLOR="0;33"
+		PRETTY_NAME="LumeBSD $_version (Farol)"
 __EOF__
 	install -C -o root -g wheel -m ${osrelease_perms} "$t" "${osrelease_file}"
 	rm -f "$t"
