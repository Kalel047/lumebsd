---
 sys/amd64/conf/LUME | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/sys/amd64/conf/LUME b/sys/amd64/conf/LUME
index 688ff44a8..889e351b4 100644
--- a/sys/amd64/conf/LUME
+++ b/sys/amd64/conf/LUME
@@ -1,14 +1,13 @@
 #
 # LUME -- kernel do LumeBSD 1.1 "Farol" para amd64.
-# Parte do GENERIC: todos os drivers e módulos, DTrace e ZFS, sem os
-# símbolos de depuração do kernel (que ocupam centenas de MB).
+# Parte do GENERIC: todos os drivers e módulos, DTrace e ZFS.
+# Os símbolos de depuração são gerados (o DTrace precisa deles para o CTF),
+# mas não são instalados (WITHOUT_DEBUG_FILES no src.conf).
 #
 include		GENERIC
 
 ident		LUME
 
-nomakeoptions	DEBUG
-
 # Contabilidade de recursos ligada: o vigia(8) mede memória, CPU e
 # processos de cada serviço e aplica os limites com o RCTL.
 nooptions	RACCT_DEFAULT_TO_DISABLED
