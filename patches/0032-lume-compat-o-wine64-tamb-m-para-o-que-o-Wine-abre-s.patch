---
 usr.sbin/lume-configurar/lume-compat.sh | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/usr.sbin/lume-configurar/lume-compat.sh b/usr.sbin/lume-configurar/lume-compat.sh
index f6904c68f..48df6606b 100644
--- a/usr.sbin/lume-configurar/lume-compat.sh
+++ b/usr.sbin/lume-configurar/lume-compat.sh
@@ -119,10 +119,14 @@ abrir() {
 		    "Preparando o Wine na primeira vez; leva cerca de um minuto." 20 &
 	fi
 	cd "$(dirname "$f")" || exit 1
+	# Tudo pelo wine64, também os processos que o Wine abre sozinho (o
+	# wineboot da primeira vez, o start): o "wine" do FreeBSD exige o i386.
+	WINELOADER=/usr/local/bin/wine64
+	export WINELOADER
 	case "$f" in
 	*.[mM][sS][iI])	exec wine64 msiexec /i "$f" ;;
 	*.[bB][aA][tT]|*.[cC][mM][dD])	exec wine64 cmd /c "$f" ;;
-	*)		exec wine64 start /unix "$f" ;;
+	*)		exec wine64 "$f" ;;
 	esac
 }
 
