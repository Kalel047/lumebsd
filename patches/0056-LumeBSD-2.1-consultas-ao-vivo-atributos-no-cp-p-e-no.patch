-			    cumpre(e->fts_accpath, c, argc, valor)) {
-				puts(e->fts_path);
-				achados++;
+				break;
 			}
+			if (vivo)
+				vigiar(e->fts_path);
+			if (e->fts_level > 0 || !eh_raiz)
+				avaliar(e->fts_path, false);
 			break;
 		case FTS_F:
-			if (e->fts_name[0] != '.' &&
-			    cumpre(e->fts_accpath, c, argc, valor)) {
-				puts(e->fts_path);
-				achados++;
-			}
+			if (e->fts_name[0] != '.')
+				avaliar(e->fts_path, false);
 			break;
 		default:
 			break;
 		}
 	}
 	fts_close(fts);
-	free(valor);
-	free(c);
-	return (achados > 0 ? 0 : 1);
+}
