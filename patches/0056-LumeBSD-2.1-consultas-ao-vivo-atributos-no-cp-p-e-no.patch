+		memset(vigias + nvigias, 0, (n - nvigias) * sizeof(*vigias));
+		nvigias = n;
+	}
+	free(vigias[wd]);
+	if ((vigias[wd] = strdup(pasta)) == NULL)
 		err(1, NULL);
-	for (int i = 0; i < argc; i++)
