+/*
+ * LumeBSD: os atributos estendidos do espaço "user" (as etiquetas, a nota e
+ * o comentário do lume-atributo(1), os mesmos do Dolphin) vão junto, como
+ * no BeOS e no macOS. Um destino que não guarda atributos (msdosfs, por
+ * exemplo) fica sem eles, em silêncio, como as ACLs.
+ */
+static int
+copy_user_extattrs(int source_fd, int dest_fd, const char *dest_name)
+{
+	char *list, *val = NULL;
+	size_t vsize = 0;
+	ssize_t lsize, n;
+	int ret = 0;
+
+	lsize = extattr_list_fd(source_fd, EXTATTR_NAMESPACE_USER, NULL, 0);
+	if (lsize <= 0)
+		return (0);
+	if ((list = malloc(lsize)) == NULL) {
+		warn("%s: extended attributes", dest_name);
+		return (-1);
+	}
+	lsize = extattr_list_fd(source_fd, EXTATTR_NAMESPACE_USER, list,
+	    lsize);
+	for (ssize_t i = 0; i < lsize; i += 1 + (unsigned char)list[i]) {
+		char name[EXTATTR_MAXNAMELEN + 1];
+		size_t len = (unsigned char)list[i];
+
+		if (i + 1 + (ssize_t)len > lsize)
+			break;
+		memcpy(name, list + i + 1, len);
+		name[len] = '\0';
+		n = extattr_get_fd(source_fd, EXTATTR_NAMESPACE_USER, name,
+		    NULL, 0);
+		if (n < 0)
+			continue;
+		if ((size_t)n >= vsize) {
+			char *nval = realloc(val, n + 1);
+
+			if (nval == NULL) {
+				warn("%s: extended attributes", dest_name);
+				ret = -1;
+				break;
+			}
+			val = nval;
+			vsize = n + 1;
+		}
+		n = extattr_get_fd(source_fd, EXTATTR_NAMESPACE_USER, name,
+		    val, vsize);
+		if (n < 0)
+			continue;
+		if (extattr_set_fd(dest_fd, EXTATTR_NAMESPACE_USER, name, val,
+		    n) < 0) {
+			if (errno == EOPNOTSUPP)
+				break;
+			warn("%s: extended attribute %s", dest_name, name);
+			ret = -1;
+		}
+	}
+	free(val);
+	free(list);
+	return (ret);
+}
