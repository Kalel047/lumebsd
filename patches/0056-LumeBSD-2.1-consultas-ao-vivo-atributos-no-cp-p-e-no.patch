+static void
+vigiar(const char *pasta)
+{
+	int wd;
+
+	wd = inotify_add_watch(ifd, pasta, IN_ATTRIB | IN_CREATE | IN_DELETE |
+	    IN_MOVED_FROM | IN_MOVED_TO | IN_DELETE_SELF | IN_ONLYDIR |
+	    IN_DONT_FOLLOW);
+	if (wd < 0) {
+		warn("%s", pasta);
+		return;
 	}
-	argc -= optind;
-	argv += optind;
