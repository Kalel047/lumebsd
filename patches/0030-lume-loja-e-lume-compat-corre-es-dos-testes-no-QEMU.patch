-			fi ;;
-		esac
 		[ $root = s ] && por_atalhos
 	fi
 	for id in $web_ids; do
@@ -406,6 +398,7 @@ abrir() {
 	existe "$1" || erro "programa desconhecido: $1"
 	e_web "$1" && web "$1"
 	a=$(campo "$1" 9)
+	[ "$a" = - ] && erro "$(campo "$1" 3) não tem janela: é usado por outros programas ou pelo terminal"
 	f=
 	if [ -n "$a" ] && [ -f "$SISTEMA/lume-$a" ]; then
 		f=$SISTEMA/lume-$a
