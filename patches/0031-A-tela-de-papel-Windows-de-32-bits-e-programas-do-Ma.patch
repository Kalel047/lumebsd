+		[ -n "$tem" ] || continue
+		if [ -f $K/$v/lume_tinta.so ] && [ "$(cat $K/$v/versao 2>/dev/null)" = "$tem" ]; then
+			instalar $K/$v/lume_tinta.so $plug/lume_tinta.so 0555
+		else
+			rm -f $plug/lume_tinta.so
+		fi
