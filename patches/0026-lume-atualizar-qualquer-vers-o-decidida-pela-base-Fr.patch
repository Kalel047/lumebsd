+# baixar_pacote: o .tar.zst do índice em $CACHE, conferido pelo SHA256
+baixar_pacote()
+{
+	pacote=$CACHE/$I_ARQUIVO
+	if [ -f "$pacote" ] && [ "$(sha256 -q "$pacote")" = "$I_SHA256" ]; then
+		return 0
