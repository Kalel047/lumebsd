+		msg "Baixando ${NEGRITO}$I_ARQUIVO${FIM}..."
+		fetch -r -o "$pacote.parcial" "$I_URL" ||
+		    erro "o download falhou; tente de novo (ele continua de onde parou)"
+	fi
