-windows|sistema|Programas do Windows (Wine)|wine wine-mono wine-gecko winetricks||Windows|Roda muitos programas .exe do Windows. Depois de instalado, é só dar dois cliques no .exe.|wine|
+windows|sistema|Programas do Windows (Wine)|wine wine-mono wine-gecko winetricks||Windows|Roda muitos programas .exe de 64 bits do Windows. Depois de instalado, é só dar dois cliques no .exe.|wine|
 linux|sistema|Programas do Linux|+linux linux_base-rl9||Linux|A camada que roda programas feitos para Linux (Rocky Linux 9), como o Chrome e o Discord.|tux|-
 virtualbox|sistema|VirtualBox|virtualbox-ose-72||VirtualBox, VMware|Máquinas virtuais: rode um Windows inteiro numa janela, para o que nada mais resolve.|virtualbox|
 filelight|sistema|Filelight|filelight||WinDirStat|Mostra o que está ocupando o disco.|filelight|
diff --git a/usr.sbin/lume-configurar/lume-compat.sh b/usr.sbin/lume-configurar/lume-compat.sh
index 4480dbdcf..f6904c68f 100644
--- a/usr.sbin/lume-configurar/lume-compat.sh
+++ b/usr.sbin/lume-configurar/lume-compat.sh
@@ -21,14 +21,26 @@ ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
 erro() { printf '  \033[31m✗\033[0m %s\n' "$*" >&2; exit 1; }
 precisa_root() { [ $root = s ] || erro "precisa ser root (su -)"; }
 
-tem_wine()  { [ -x /usr/local/bin/wine ]; }
+tem_wine()  { [ -x /usr/local/bin/wine64 ]; }
+
+# 64 ou 32: o tipo de máquina no cabeçalho PE de um .exe ("?" se não for).
+pe_bits()
+{
+	off=$(od -An -tu4 -j60 -N4 "$1" 2>/dev/null | tr -d ' ')
+	[ -n "$off" ] || { echo "?"; return; }
+	case $(od -An -tx2 -j$((off + 4)) -N2 "$1" 2>/dev/null | tr -d ' ') in
+	8664|aa64)	echo 64 ;;
+	014c)		echo 32 ;;
+	*)		echo "?" ;;
+	esac
+}
 linux_on()  { kldstat -q -m linuxelf 2>/dev/null || kldstat -q -n linux64 2>/dev/null; }
 linux_cfg() { [ "$(sysrc -n linux_enable 2>/dev/null)" = YES ]; }
 
 estado() {
 	echo
 	if tem_wine; then
-		ok "Windows: Wine $(wine --version 2>/dev/null | sed 's/^wine-//') instalado (dois cliques num .exe)"
+		ok "Windows: Wine $(pkg query %v wine 2>/dev/null) instalado (dois cliques num .exe de 64 bits)"
 	else
 		echo "  · Windows: desligado (lume loja instalar windows)"
 	fi
@@ -68,11 +80,30 @@ linux() {
 # Abre um .exe/.msi/.bat com o Wine (o atalho "Programa do Windows" do
 # Dolphin chama isto). Na primeira vez, oferece instalar o Wine pelo app
 # Programas do LumeBSD, que pede a senha e mostra o progresso.
+#
+# Só 64 bits: o Wine do FreeBSD 15 roda os de 32 bits com uma cópia i386 do
+# Wine e as bibliotecas de 32 bits do sistema (lib32), que o FreeBSD 15 não
+# empacota mais. Um .exe de 32 bits ganha uma explicação, não um erro mudo.
 abrir() {
 	f=$1
 	[ -f "$f" ] || erro "arquivo não encontrado: $f"
+	grafico=n
+	[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v kdialog >/dev/null && grafico=s
+	case "$f" in
+	*.[eE][xX][eE])
+		if [ "$(pe_bits "$f")" = 32 ] && [ ! -x "$HOME/.i386-wine-pkg/usr/local/bin/wine" ]; then
+			txt="<b>${f##*/}</b> é um programa do Windows de <b>32 bits</b>.<br><br>O LumeBSD roda os programas do Windows de 64 bits; os de 32 bits ainda não (o FreeBSD 15 não traz mais a parte de 32 bits que o Wine usa para eles).<br><br>Procure a versão de 64 bits no site do programa (muitos oferecem as duas), a versão para a web, ou um substituto no app Programas do LumeBSD."
+			if [ $grafico = s ]; then
+				kdialog --title "Programa do Windows" --yes-label "Abrir a Ajuda" \
+				    --no-label "Fechar" --warningyesno "$txt" &&
+				    exec /usr/sbin/lume-ajuda windows
+				exit 0
+			fi
+			erro "${f##*/} é de 32 bits; o LumeBSD roda os programas do Windows de 64 bits (lume ajuda windows)"
+		fi ;;
+	esac
 	if ! tem_wine; then
-		if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v kdialog >/dev/null; then
+		if [ $grafico = s ]; then
 			kdialog --title "Programa do Windows" --yes-label "Instalar" \
 			    --no-label "Cancelar" --yesno "<b>${f##*/}</b> é um programa do Windows.<br><br>O LumeBSD abre muitos deles com o <b>Wine</b>, que ainda não está instalado (baixa cerca de 700 MB).<br><br>Instalar agora?" ||
 			    exit 0
@@ -83,22 +114,22 @@ abrir() {
 		fi
 	fi
 	# A primeira vez cria a "unidade C:" em ~/.wine e demora um pouco.
-	if [ ! -d "${WINEPREFIX:-$HOME/.wine}" ] && command -v kdialog >/dev/null; then
+	if [ ! -d "${WINEPREFIX:-$HOME/.wine}" ] && [ $grafico = s ]; then
 		kdialog --title "Programa do Windows" --passivepopup \
 		    "Preparando o Wine na primeira vez; leva cerca de um minuto." 20 &
 	fi
 	cd "$(dirname "$f")" || exit 1
 	case "$f" in
-	*.[mM][sS][iI])	exec wine msiexec /i "$f" ;;
-	*.[bB][aA][tT]|*.[cC][mM][dD])	exec wine cmd /c "$f" ;;
-	*)		exec wine start /unix "$f" ;;
+	*.[mM][sS][iI])	exec wine64 msiexec /i "$f" ;;
+	*.[bB][aA][tT]|*.[cC][mM][dD])	exec wine64 cmd /c "$f" ;;
+	*)		exec wine64 start /unix "$f" ;;
 	esac
 }
 
 case "${1:-}" in
 ""|estado)	estado ;;
 linux)		shift; linux "$@" ;;
-windows)	if tem_wine; then ok "Wine instalado: dois cliques num .exe abrem o programa."
+windows)	if tem_wine; then ok "Wine instalado: dois cliques num .exe de 64 bits abrem o programa."
 		else echo "  Para programas do Windows: lume loja instalar windows"; fi ;;
 abrir)		shift; abrir "$1" ;;
 *)	echo "uso: lume compat [estado | linux [ligar | desligar] | windows | abrir ARQUIVO]" >&2
diff --git a/usr.sbin/lume-configurar/lume-loja.sh b/usr.sbin/lume-configurar/lume-loja.sh
index 5be7024ac..89ab2420b 100644
--- a/usr.sbin/lume-configurar/lume-loja.sh
+++ b/usr.sbin/lume-configurar/lume-loja.sh
@@ -216,14 +216,6 @@ instalar() {
 		for p in $pks; do pkg_ok "$p" || falta="$falta $p"; done
 		[ -z "$falta" ] || erro "não deu para instalar:$falta"
 		app "passo 3 3 Arrumando o menu"
-		# Programas do Windows de 32 bits (a maioria dos instaladores).
-		case " $pks " in *" wine "*)
-			if [ -x /usr/local/share/wine/pkg32.sh ]; then
-				msg "Preparando o Wine para programas de 32 bits..."
-				/usr/local/share/wine/pkg32.sh install -y wine mesa-dri >/dev/null 2>&1 ||
-				    msg "(sem o suporte a 32 bits; programas de 64 bits funcionam)"
-			fi ;;
-		esac
 		[ $root = s ] && por_atalhos
 	fi
 	for id in $web_ids; do
