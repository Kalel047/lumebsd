---
 usr.sbin/pkg/Makefile | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/usr.sbin/pkg/Makefile b/usr.sbin/pkg/Makefile
index 68b862826..1fc49da08 100644
--- a/usr.sbin/pkg/Makefile
+++ b/usr.sbin/pkg/Makefile
@@ -6,7 +6,10 @@ BRANCH?=	${_BRANCH}
 .if ${BRANCH:MCURRENT} != ""
 PKGCONFBRANCH?=	latest
 .else
-. if ${BRANCH:MBETA*} || ${BRANCH:MRC*} || ${BRANCH:MRELEASE*}
+. if ${BRANCH:MBETA*} || ${BRANCH:MRC*} || ${BRANCH:MRELEASE*} || \
+    ${BRANCH:MFAROL*}
+# LumeBSD: as versões "Farol" seguem uma release do FreeBSD (15.1), então
+# usam os pacotes trimestrais e os módulos do kernel feitos para ela.
 PKGCONFBRANCH?=	quarterly-release
 . else
 .  if ${MACHINE} != "amd64" && ${MACHINE} != "i386" && ${MACHINE} != "arm64"
