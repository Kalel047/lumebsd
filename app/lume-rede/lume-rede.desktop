[Desktop Entry]
Type=Application
Name=Network
Name[pt_BR]=Rede
Comment=Wired and Wi-Fi networks (LumeBSD)
Comment[pt_BR]=Cabo e Wi-Fi: as redes por perto, conectar e esquecer (LumeBSD)
